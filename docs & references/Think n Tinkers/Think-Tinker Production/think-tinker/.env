# --- APP ---
APP_NAME="Think & Tinker Kids Club"
APP_URL=https://think-tinker.com
HUB_URL=https://hub.think-tinker.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vmtqyldz_thinktinker_db
DB_USER=vmtqyldz_thinktinker_user
DB_PASS=Jesus@2026
DB_CHARSET=utf8mb4

# --- SMTP EMAIL ---
SMTP_HOST=mail.think-tinker.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=no-reply@think-tinker.com
SMTP_PASS=Jesus@2026
SMTP_FROM_EMAIL=no-reply@think-tinker.com
SMTP_FROM_NAME="Think & Tinker Kids Club"

# --- SECURITY ---
SESSION_LIFETIME=1800
CSRF_TOKEN_NAME=_token
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8

# --- FILE UPLOADS ---
UPLOAD_MAX_SIZE_MB=10
IMAGE_MAX_WIDTH=1200
PRODUCT_IMAGE_MAX_WIDTH=800
PROFILE_IMAGE_MAX_WIDTH=400
OG_IMAGE_WIDTH=1200
OG_IMAGE_HEIGHT=630
ALLOWED_IMAGE_TYPES=jpeg,jpg,png,webp
ALLOWED_DOC_TYPES=pdf,doc,docx

# --- PATHS (relative to document root) ---
UPLOAD_DIR=uploads
PDF_TEMPLATE_DIR=pdf-templates
LOG_DIR=logs
BACKUP_DIR=backups

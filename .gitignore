# ============================================================
#  Think & Tinker — .gitignore
#
#  Rule: if it is not a secret, it is tracked.
#  Everything below is either a credential, runtime data that
#  belongs to users rather than the codebase, or a folder that
#  is restored by a single command.
# ============================================================


# --- Credentials --------------------------------------------
# The ONLY category that exists for secrecy reasons.
# includes/config.php is intentionally NOT ignored: it reads
# its values from .env rather than hardcoding them.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example


# --- User data, not code -------------------------------------
# Parent and child photos, uploaded documents, invoices, logs.
# Committing these would put customer PII into git history.
public_html/uploads/*
!public_html/uploads/.gitkeep
public_html/logs/*
!public_html/logs/.gitkeep
*.log


# --- Restored by one command ---------------------------------
# `composer install` regenerates this exactly. Tracking it adds
# thousands of third-party files to every diff. Say the word and
# I will remove this rule.
public_html/vendor/


# --- Machine noise -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.tmp

# Editor settings are per-machine, but shared config is kept.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json


# --- Database dumps containing live customer data ------------
# Schema and seeds under Database/ ARE tracked. These patterns
# only catch ad-hoc production dumps.
*-backup.sql
*-dump.sql
backup-*.sql
